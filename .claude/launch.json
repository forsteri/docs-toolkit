{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-toolkit-docusaurus",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docusaurus", "run", "start", "--", "--host", "127.0.0.1", "--port", "3000", "--no-open"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "docs-toolkit-docusaurus-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docusaurus", "run", "serve", "--", "--host", "127.0.0.1", "--port", "3200", "--no-open"],
      "port": 3200,
      "url": "http://127.0.0.1:3200"
    },
    {
      "name": "repo-static-files",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3300", "--bind", "127.0.0.1", "--directory", "."],
      "port": 3300
    }
  ]
}
